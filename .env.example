# ===========================================
# Neura AI App Builder - Environment Config
# ===========================================

# Supabase (optional - for project storage & RAG)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===========================================
# LLM Provider Configuration
# Priority: Groq > OpenRouter > OpenAI
# (First valid API key wins)
# ===========================================

# Option 1: Groq (RECOMMENDED - fastest inference)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile
# Other Groq models: llama-3.1-8b-instant, mixtral-8x7b-32768

# Option 2: OpenRouter (access to 100+ models)
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key
# LLM_MODEL=anthropic/claude-3.5-sonnet
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Option 3: OpenAI Direct
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key
# LLM_MODEL=gpt-4o

# ===========================================
# App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
